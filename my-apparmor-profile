#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  signal,

  deny /etc/passwd r,
  deny /etc/shadow r,
  deny /var/** rw,
  deny /bin/bash x,
  deny /usr/bin/bash x,
  deny /usr/bin/dash x,
  deny capability sys_admin,
}
